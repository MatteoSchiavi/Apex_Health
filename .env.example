# Apex Health — environment template
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Core ---
# Container-network URLs (used inside docker compose) are set in infra/docker-compose.yml.
# For host-side commands (alembic, pytest, sandbox runs), point these at localhost.
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
ENVIRONMENT=prod
# URL-safe random password; compose uses the same value for app and DB.
POSTGRES_PASSWORD=

# --- Garmin (real account connected manually by the owner) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Whoop (official Developer API v2 — a PRIMARY device alongside Garmin) ---
# Register once at developer.whoop.com: "Create an app", pick USER data
# access, add all read scopes + `offline`, and set the redirect URI exactly
# as registered (whitelist). Then fill:
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/integrations/whoop/callback
# (the authorize/token/base URLs have correct spec defaults; no need to set
#  them unless Whoop revises their API — INSTALL §7b has the full recipe)

# --- Oura (optional official API v2; registered app and user consent required) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8000/integrations/oura/callback
OURA_SCOPE=daily heartrate personal
# Production redirect must match your public BASE_URL and Oura app registration.

# --- Strava (official REST API v3 — GPS companion source) ---
# Register once at strava.com/settings/api → "Create & Manage Your App";
# authorization callback domain = your host (e.g. apex.example.com or
# localhost). Scope defaults to activity:read_all. INSTALL §7c.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:8000/integrations/strava/callback

# --- Technogym (§11) — DEAD END, owner-confirmed ---
# The Technogym API is B2B-only (a partner agreement is required); personal
# accounts cannot register an OAuth client. The connector stays dormant in
# code but there is nothing to connect to. Leave these unset:
# TECHNOGYM_CLIENT_ID=
# TECHNOGYM_CLIENT_SECRET=
# TECHNOGYM_REDIRECT_URI=
# TECHNOGYM_OAUTH_AUTHORIZE_URL=
# TECHNOGYM_OAUTH_TOKEN_URL=
# TECHNOGYM_API_BASE=
# TECHNOGYM_SCOPE=

# --- LLM providers ---
# DEEPSEEK_API_KEY selects DeepSeek when per-tier overrides below are empty.
# Custom compatible endpoints need their own per-tier model, URL and key.
# See docs/COACH_SETUP.md; keep credentials private.
LLM_PROVIDER_CHEAP=
LLM_PROVIDER_POWERFUL=
GLM_API_KEY=
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# --- OpenAI: embeddings (text-embedding-3-small) + Whisper STT ---
# OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Cost governance and backups ---
# Daily per-account AI spend estimate (USD). Atomic pre-call reservations
# enforce this ceiling as well as token/category limits. <=0 disables only
# the USD ceiling; token limits remain enforced. Consent is always required.
DAILY_TOKEN_BUDGET_USD=0.25
AI_PROCESSING_ENABLED=true
AI_DAILY_TOKEN_LIMIT=160000
# §22.7: nightly pg_dump at 02:00 UTC, encrypted with a key DEDICATED to
# backups (independent from ENCRYPTION_KEY). Unset => the backup task logs
# an honest skip instead of ever writing a plaintext dump.
BACKUP_ENCRYPTION_KEY=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Offsite upload target (Backblaze B2 free tier). Unset => upload skipped
# with a logged note; local encrypted copies still happen.
B2_BUCKET=
# Optional overrides — defaults noted:
# BACKUP_DIR=<repo>/backups
# PG_DUMP_BIN=pg_dump
# BACKUP_RETAIN_DAILY=14
# BACKUP_RETAIN_MONTHLY=6

# --- Owner bootstrap (owner account created at startup) ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Public legal notice facts for this deployment (never put secrets here) ---
# Review docs/LEGAL_DEPLOYMENT.md. The public /legal/config endpoint exposes
# these fields; empty values leave a visible incomplete-notice warning.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_ACCOUNT_BASIS=
LEGAL_HEALTH_BASIS=
LEGAL_HOSTING_REGION=
LEGAL_AI_PROCESSOR=
LEGAL_BACKUP_LOCATION=
LEGAL_TRANSFER_DETAILS=

# --- Optional external food diary (read-only Fitbit nutrition OAuth) ---
# Register an app with Fitbit and the exact public HTTPS callback URL. See
# docs/UI_DATA_CHANGES.md. Leave unset to keep the integration unavailable.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8000/integrations/fitbit/callback

# --- Weather (keyless Open-Meteo) ---
# Set home coordinates to enable forecast cache + activity weather enrichment.
WEATHER_HOME_LAT=0
WEATHER_HOME_LON=0
# WEATHER_FORECAST_DAYS=7

# --- Remote access behind a trusted reverse proxy ---
# true ONLY when the app sits behind a loopback TLS terminator.
# TRUST_PROXY_HEADERS=false
# Exact trusted peers; a host reverse proxy through Docker may use the bridge gateway.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Session and hardening tunables — defaults in app/core/config.py ---
# SESSION_TTL_MINUTES=720
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Restore tooling override (sandboxes/containers) ---
# PSQL_BIN=psql

# --- Medical module ---
# ng/mL cutoff for the low-ferritin alert when a panel carries no
# lab-provided reference low. Default 30.0 — adjust with the owner's lab.
LOW_FERRITIN_NG_ML=30.0

# --- Compose-only (used by infra/docker-compose.yml, not read by the app) ---
# Leave POSTGRES_* commented to keep the compose defaults (hcc/hcc/hcc) —
# db and redis publish no ports, they are only reachable on the compose
# network. If you change them, override them for the compose interpolation
# too (infra/.env or docker compose --env-file), or db and api will disagree.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# API port on the host (default 8000):
# API_PORT=8000

# --- COROS through your MCP server (not a direct COROS API) ---
# The server must authenticate and scope data to each account's bearer token.
# Insert the server's real tool name/contract; see docs/COROS_MCP.md.
COROS_MCP_URL=
COROS_MCP_ACTIVITY_TOOL=
COROS_MCP_ACTIVITY_ARGS={}
# COROS_MCP_TIMEOUT_SECONDS=30

# Optional dedicated outbound owner operational Telegram notifications
OWNER_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=

# DeepSeek: setting this key alone selects the official API for ordinary tiers.
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODEL_POWERFUL=deepseek-v4-pro
# DEEPSEEK_THINKING=false
# Explicit tier overrides win; a custom endpoint requires both key and model.
# LLM_API_BASE_CHEAP=
# LLM_API_KEY_CHEAP=
# LLM_API_BASE_POWERFUL=
# LLM_API_KEY_POWERFUL=
