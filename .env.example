# Health Control Center — environment template (MASTER_SPEC §5)
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Core ---
# Container-network URLs (used inside docker compose) are set in infra/docker-compose.yml.
# For host-side commands (alembic, pytest, sandbox runs), point these at localhost.
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

# --- Garmin (real account connected manually by the owner — §0, §16.7) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Technogym (§11) — DEAD END, owner-confirmed ---
# The Technogym API is B2B-only (a partner agreement is required); personal
# accounts cannot register an OAuth client. The connector stays dormant in
# code but there is nothing to connect to. Leave these unset:
# TECHNOGYM_CLIENT_ID=
# TECHNOGYM_CLIENT_SECRET=
# TECHNOGYM_REDIRECT_URI=
# TECHNOGYM_OAUTH_AUTHORIZE_URL=
# TECHNOGYM_OAUTH_TOKEN_URL=
# TECHNOGYM_API_BASE=
# TECHNOGYM_SCOPE=

# --- Telegram bot (long polling — no webhook secret needed this round, §10) ---
TELEGRAM_BOT_TOKEN=

# --- LLM providers (§2, §9) ---
# Any OpenAI-compatible chat endpoint works: point GLM_API_BASE at it and
# name the models via LLM_PROVIDER_* (env-var swappable, no code change).
LLM_PROVIDER_CHEAP=
LLM_PROVIDER_POWERFUL=
GLM_API_KEY=
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# --- OpenAI: embeddings (pinned text-embedding-3-small, §6.2) + Whisper STT ---
# OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Cost governance & backups (§8.6, §22.7) ---
# Daily per-account AI spend estimate (USD) that fires an informational
# budget_warning alert (§8.6). Default 0.25 when unset; <=0 disables.
DAILY_TOKEN_BUDGET_USD=
# §22.7: nightly pg_dump at 02:00 UTC, encrypted with a key DEDICATED to
# backups (independent from ENCRYPTION_KEY). Unset => the backup task logs
# an honest skip instead of ever writing a plaintext dump.
BACKUP_ENCRYPTION_KEY=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Offsite upload target (Backblaze B2 free tier). Unset => upload skipped
# with a logged note; local encrypted copies still happen.
B2_BUCKET=
# Optional overrides — defaults noted:
# BACKUP_DIR=<repo>/backups
# PG_DUMP_BIN=pg_dump
# BACKUP_RETAIN_DAILY=14
# BACKUP_RETAIN_MONTHLY=6

# --- Owner bootstrap (owner account created at startup, §15) ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Weather (§14, keyless Open-Meteo) ---
# Set home coordinates to enable forecast cache + activity weather enrichment.
WEATHER_HOME_LAT=
WEATHER_HOME_LON=
# WEATHER_FORECAST_DAYS=7
# WEATHER_NUDGE_READINESS_THRESHOLD=70

# --- Remote access behind Tailscale Funnel / Caddy (§15) ---
# true ONLY when the app sits behind a loopback TLS terminator.
# TRUST_PROXY_HEADERS=false

# --- Session / hardening tunables (§22) — defaults in app/core/config.py ---
# SESSION_TTL_MINUTES=720
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Restore tooling override (sandboxes/containers) ---
# PSQL_BIN=psql

# --- Medical module (§23 Phase 4) ---
# ng/mL cutoff for the low-ferritin alert when a panel carries no
# lab-provided reference low. Default 30.0 — adjust with the owner's lab.
LOW_FERRITIN_NG_ML=30.0

# --- Compose-only (used by infra/docker-compose.yml, not read by the app) ---
# Leave POSTGRES_* commented to keep the compose defaults (hcc/hcc/hcc) —
# db and redis publish no ports, they are only reachable on the compose
# network. If you change them, override them for the compose interpolation
# too (infra/.env or docker compose --env-file), or db and api will disagree.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# API port on the host (default 8000):
# API_PORT=8000
