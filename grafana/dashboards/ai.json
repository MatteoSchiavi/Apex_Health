  {
   "id": 162,
   "type": "stat",
   "title": "Tool error rate (30d)",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT ROUND(100.0*COUNT(*) FILTER (WHERE error IS NOT NULL)/NULLIF(COUNT(*),0),1) AS value FROM agent_tool_calls atc JOIN ai_chat_sessions s ON s.id=atc.session_id WHERE s.user_id=$user AND atc.created_at > now() - interval '30 days'",
     "refId": "A",
     "format": "table"
