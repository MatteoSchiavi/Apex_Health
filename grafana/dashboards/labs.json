  {
   "id": 193,
   "type": "table",
   "title": "Panel history",
   "description": "Notes are stored encrypted (notes_ciphertext) \u2014 not rendered here by design.",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
