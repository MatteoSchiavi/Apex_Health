  {
   "id": 187,
   "type": "stat",
   "title": "Metrics in range (%)",
   "description": "",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT ROUND(100.0*COUNT(*) FILTER (WHERE lm.value BETWEEN lm.ref_low AND lm.ref_high)/NULLIF(COUNT(*),0),0) AS value FROM lab_metrics lm JOIN lab_panels lp ON lp.id=lm.lab_panel_id WHERE lp.user_id=$user AND lm.ref_low IS NOT NULL AND lp.date = (SELECT MAX(date) FROM lab_panels WHERE user_id=$user)",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "green",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto",
    "colorMode": "value",
