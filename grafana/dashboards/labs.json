  {
   "id": 191,
   "type": "table",
   "title": "Latest metrics vs reference ranges",
   "description": "Latest value per metric against the stored \u00a712 reference range.",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 14,
    "h": 10
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT DISTINCT ON (lm.metric_name) lm.metric_name AS \"metric\", lm.value AS \"value\", lm.unit AS \"unit\", lm.ref_low AS \"ref low\", lm.ref_high AS \"ref high\", CASE WHEN lm.value < lm.ref_low THEN '\u25bc LOW' WHEN lm.value > lm.ref_high THEN '\u25b2 HIGH' ELSE '\u25cf in range' END AS \"flag\", to_char(lp.date,'YYYY-MM-DD') AS \"panel date\" FROM lab_metrics lm JOIN lab_panels lp ON lp.id = lm.lab_panel_id WHERE lp.user_id=$user ORDER BY lm.metric_name, lp.date DESC",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
