   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT local_date AS \"time\", ROUND((duration_s/60.0)/(distance_m/1000.0),2) AS min_per_km FROM activities a JOIN disciplines d ON d.id=a.discipline_id WHERE a.user_id=$user AND d.name='running' AND distance_m > 0 AND $__timeFilter(local_date) ORDER BY local_date",
     "refId": "A",
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
