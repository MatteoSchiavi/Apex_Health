  {
   "id": 120,
   "type": "table",
   "title": "Recent activities",
   "description": "Weather column comes from \u00a714 enrichment (weather_snapshot).",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 11
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT to_char(a.local_date,'YYYY-MM-DD') AS \"date\", d.name AS \"discipline\", to_char(a.start_time AT TIME ZONE 'Europe/Rome', 'MM-DD HH24:MI') AS \"start\", ROUND(a.duration_s/60.0) AS \"min\", ROUND(a.distance_m/1000.0,1) AS \"km\", a.avg_hr AS \"avg hr\", a.max_hr AS \"max hr\", a.avg_power AS \"avg W\", a.calories AS \"kcal\", a.training_load AS \"load\", a.weather_snapshot->>'temperature_2m_mean' AS \"temp\", a.data_completeness AS \"quality\" FROM activities a JOIN disciplines d ON d.id=a.discipline_id WHERE a.user_id=$user ORDER BY a.start_time DESC LIMIT 25",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 121,
   "type": "timeseries",
   "title": "Run pace (min/km)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
