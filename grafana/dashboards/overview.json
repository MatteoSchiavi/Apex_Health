  {
   "id": 113,
   "type": "table",
   "title": "Alerts (\u00a717)",
   "description": "\u00a717 alert rows \u2014 lowest acknowledgement first.",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT type AS \"type\", severity AS \"severity\", message AS \"message\", triggered_at AS \"triggered\", acknowledged AS \"ack\" FROM alerts WHERE user_id=$user ORDER BY acknowledged ASC, triggered_at DESC LIMIT 8",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "severity"
      },
      "properties": [
       {
        "id": "mappings",
        "value": {
         "type": "value",
         "options": {
          "critical": {
           "color": "red",
           "index": 0,
           "text": "critical"
          },
          "error": {
           "color": "red",
           "index": 1,
           "text": "error"
          },
          "warning": {
           "color": "orange",
           "index": 2,
           "text": "warning"
          },
          "info": {
           "color": "blue",
           "index": 3,
           "text": "info"
          },
          "sync_failure": {
           "color": "red",
           "index": 4,
           "text": "sync_failure"
          }
         }
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
