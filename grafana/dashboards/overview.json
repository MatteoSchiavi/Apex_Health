  {
   "id": 111,
   "type": "table",
   "title": "Upcoming planned sessions",
   "description": "\u00a711 \u2014 confirmed/active plans only; drafts stay hidden.",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT ps.date AS \"date\", dn.name AS \"discipline\", ps.session_type AS \"type\", ps.target_duration_min AS \"target min\", ps.target_load AS \"target load\", ps.description AS \"description\" FROM planned_sessions ps JOIN training_plans tp ON tp.id = ps.training_plan_id JOIN disciplines dn ON dn.id = ps.discipline_id WHERE tp.user_id=$user AND tp.status IN ('active','confirmed') AND ps.date >= CURRENT_DATE ORDER BY ps.date LIMIT 10",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 112,
   "type": "table",
   "title": "Forecast (home coords)",
   "description": "\u00a714 forecast cache \u2014 WMO codes via \u00a78.2 table.",
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT fc.date AS \"date\", CASE (fc.payload->>'weather_code')::int WHEN 0 THEN 'Clear' WHEN 1 THEN 'Mostly clear' WHEN 2 THEN 'Partly cloudy' WHEN 3 THEN 'Overcast' WHEN 45 THEN 'Fog' WHEN 51 THEN 'Drizzle' WHEN 61 THEN 'Light rain' WHEN 63 THEN 'Rain' WHEN 65 THEN 'Heavy rain' WHEN 71 THEN 'Snow' WHEN 80 THEN 'Showers' WHEN 95 THEN 'Thunderstorm' ELSE 'code ' || (fc.payload->>'weather_code') END AS \"weather\", fc.payload->>'temperature_2m_max' AS \"t max\", fc.payload->>'temperature_2m_min' AS \"t min\", fc.payload->>'wind_speed_10m_max' AS \"wind\", fc.payload->>'precipitation_sum' AS \"precip\" FROM forecast_cache fc WHERE fc.date >= CURRENT_DATE ORDER BY fc.date LIMIT 7",
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": null,
     "custom": {},
     "min": null,
     "max": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  }
