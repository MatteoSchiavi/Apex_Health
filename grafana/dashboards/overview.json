  {
   "id": 120,
   "type": "table",
   "title": "Forecast (home coords)",
   "description": "\u00a714 forecast cache \u2014 WMO codes via \u00a78.2 table. Good-window: 5\u201328 \u00b0C, rain \u2264 40 %, wind \u2264 35 km/h.",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "apex-pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "apex-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT fc.date AS \"date\", CASE (fc.payload->>'weather_code')::int WHEN 0 THEN '\u2600\ufe0f Clear' WHEN 1 THEN '\ud83c\udf24\ufe0f Mostly clear' WHEN 2 THEN '\u26c5 Partly cloudy' WHEN 3 THEN '\u2601\ufe0f Overcast' WHEN 45 THEN '\ud83c\udf2b\ufe0f Fog' WHEN 51 THEN '\ud83d\udca7 Drizzle' WHEN 61 THEN '\ud83c\udf26\ufe0f Light rain' WHEN 63 THEN '\ud83c\udf27\ufe0f Rain' WHEN 65 THEN '\u26c8\ufe0f Heavy rain' WHEN 71 THEN '\u2744\ufe0f Snow' WHEN 80 THEN '\ud83c\udf26\ufe0f Showers' WHEN 95 THEN '\u26c8\ufe0f Thunderstorm' ELSE 'code ' || (fc.payload->>'weather_code') END AS \"weather\", fc.payload->>'temperature_2m_max' AS \"t max \u00b0C\", fc.payload->>'temperature_2m_min' AS \"t min \u00b0C\", fc.payload->>'wind_speed_10m_max' AS \"wind km/h\", fc.payload->>'precipitation_sum' AS \"precip mm\" FROM forecast_cache fc WHERE fc.date >= CURRENT_DATE ORDER BY fc.date LIMIT 7",
     "refId": "A",
     "format": "table"
    }
   ],
