<settings>
    <!-- Apex Day — phone-side settings (Garmin Connect Mobile / Connect IQ
         store settings screen). List entries map 1:1 to the documented
         battery policy: 60/120/240-minute background refresh. -->
    <setting propertyKey="@Properties.server_url" title="@Strings.ServerUrlTitle" prompt="@Strings.ServerUrlPrompt">
        <settingConfig type="alphaNumeric" maxLength="120" readonly="false"/>
    </setting>
    <setting propertyKey="@Properties.api_token" title="@Strings.TokenTitle" prompt="@Strings.TokenPrompt">
        <settingConfig type="alphaNumeric" maxLength="80" readonly="false"/>
    </setting>
    <setting propertyKey="@Properties.refresh_interval" title="@Strings.RefreshTitle" prompt="@Strings.RefreshPrompt">
        <settingConfig type="list">
            <listEntry value="60">@Strings.Refresh60</listEntry>
            <listEntry value="120">@Strings.Refresh120</listEntry>
            <listEntry value="240">@Strings.Refresh240</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.active_start_min" title="@Strings.ActiveStartTitle" prompt="@Strings.ActiveStartPrompt">
        <settingConfig type="numeric" min="0" max="1439" readonly="false"/>
    </setting>
    <setting propertyKey="@Properties.active_end_min" title="@Strings.ActiveEndTitle" prompt="@Strings.ActiveEndPrompt">
        <settingConfig type="numeric" min="1" max="1440" readonly="false"/>
    </setting>
    <setting propertyKey="@Properties.imperial" title="@Strings.ImperialTitle" prompt="@Strings.ImperialPrompt">
        <settingConfig type="boolean" readonly="false"/>
    </setting>
</settings>
