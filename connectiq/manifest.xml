<?xml version="1.0" encoding="utf-8"?>
<!-- Apex Day — Connect IQ manifest (v3 watch app, battery-first companion).

     The app surfaces ONLY what Apex knows and Garmin does not: the AI-coach
     safety verdict, today's workout + where to find it, the gym plan with a
     set logger + rest timer, post-workout feedback, supplements, Apex alerts,
     gear/donation/event upkeep, weather window, mood journal and the week.
     Readiness / recovery / Body Battery / HR / sleep stay native on the watch.

     Target device (owner-confirmed): fenix7pro — 260x260 round MIP,
     768 KB app memory, 64 KB background, 64 KB glance, CIQ 4.x.
     Add one <iq:product> line per additional device; the code is
     device-agnostic (relative layout, round-safe insets, touch + buttons).

     Notes:
     * Glances require Connect IQ 4.0 => minSdkVersion="4.0.0" (manifest v3
       has NO minApiVersion attribute; minSdkVersion is the v3 way).
     * <iq:language> (NOT <iq:display-language>) per the manifest XSD;
       eng + ita ship, with resources-ita holding the Italian strings.
     * Permissions: Communications (makeWebRequest to the Apex server over
       HTTPS, bearer device token) and Background (60-min temporal refresh
       for the glance; registration happens in the foreground app only). -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        entry="ApexApp"
        id="f3a1c9e2b7d54a6f8e0c2d4b6a8f0c1e"
        name="@Strings.AppName"
        type="watch-app"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="4.0.0">
        <iq:products>
            <iq:product id="fenix7pro"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>ita</iq:language>
        </iq:languages>
        <iq:barrels/>
        <!-- Manifest v3 has NO <iq:glances> element (removed in the v3 XSD):
             glance support is implicit via AppBase.getGlanceView() in code
             plus minSdkVersion >= 4.0.0. -->
    </iq:application>
</iq:manifest>
